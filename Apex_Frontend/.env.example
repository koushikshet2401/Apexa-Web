# Database Connection
DATABASE_URL="postgresql://user:password@localhost:5432/apex"

# Public Site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin Authentication
JWT_SECRET="generate-with-node-crypto-randomBytes-64-base64"
ADMIN_SESSION_MAX_AGE="86400"

# Cloudflare R2 Media Storage (S3 Compatible)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="apex-media"
R2_PUBLIC_URL="https://pub-yourhash.r2.dev"

# SMTP & Email Notifications
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your@email.com"
SMTP_PASS="your_app_password"
ADMIN_EMAIL="admin@apexpacificholdings.com"
EMAIL_FROM="Apex Pacific Holdings <noreply@apexpacificholdings.com>"
