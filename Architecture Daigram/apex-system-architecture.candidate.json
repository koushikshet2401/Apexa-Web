  "cards": [
    {
      "dot": "cyan",
      "title": "Frontend & Client Layer (Next.js 15 & React 19)",
      "items": [
        "Public Website delivers cinematic hero video, 3D circular Space-in-Round, and dynamic country collections.",
        "Admin Portal provides comprehensive navigation across Portfolio (5), Website CMS (9), and Operations (4).",
        "Direct R2 Uploader streams files up to 500MB directly to Cloudflare without server body truncation."
      ]
    },
    {
      "dot": "emerald",
      "title": "Backend Services & Database Tier",
      "items": [
        "Node.js API Route Handlers enforce Jose JWT authentication, CSP headers, and RBAC permission checks.",
        "PostgreSQL 16 managed with Prisma ORM across 25 schema tables with single-source-of-truth queries.",
        "Audit Logging records all administrator actions, soft deletes, price adjustments, and closed deals."
      ]
    },
    {
      "dot": "rose",
      "title": "Cloudflare R2 Object Storage & Transfer Flow",
      "items": [
        "Presigned S3 credentials generated on the backend and returned to the client uploader.",
        "Direct client binary PUT stream writes directly to the apex-media bucket with zero server RAM pressure.",
        "Permanent deletion triggers automated DeleteObject commands to prevent R2 storage bloat."
      ]
    }
